<?xml version="1.0" encoding="UTF-8"?>
<!-- The window manager of a run's screen: it frames Chrome and nothing more. No key binding, and
     no mouse binding that opens a menu or runs a program; the owner's hands reach the whole
     display over VNC, so the display must have nothing to run. -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <placement>
    <policy>Smart</policy>
  </placement>
  <theme>
    <name>Clearlooks</name>
    <titleLayout>NLIMC</titleLayout>
  </theme>
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
  </keyboard>
  <menu>
    <file>@MENU@</file>
  </menu>
  <mouse>
    <!-- No binding on the Frame context: openbox grabs the button for it and never replays it to the
         window, so the owner's clicks would not reach Chrome (found by `make test-box`). -->
    <context name="Titlebar">
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
    </context>
  </mouse>
</openbox_config>
